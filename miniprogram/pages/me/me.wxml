<!--pages/me/me.wxml-->
<view class="me-page">
  <view class="me-card">
      <view class="me-row" bindtap="openLanguage">
        <view class="me-row-icon">A</view>
        <view class="me-row-label">{{copy.language}}</view>
        <view class="me-row-value">{{currentLangLabel}}</view>
        <view class="me-row-arrow">›</view>
      </view>
  </view>

  <!-- 未登录 -->
  <view wx:if="{{!loggedIn}}" class="me-empty">
    <view class="me-avatar-empty">WM</view>
    <view class="me-empty-text">{{copy.signedOut}}</view>
    <button class="btn" bindtap="goLogin">{{copy.login}}</button>
  </view>

  <!-- 已登录 -->
  <view wx:if="{{loggedIn}}">
    <view class="me-header">
      <view class="me-avatar">{{userInitial}}</view>
      <view class="me-info">
        <view class="me-name">{{user.name}}</view>
        <view class="me-email">{{user.email}}</view>
      </view>
    </view>

    <view class="me-card">
      <view class="me-row" bindtap="openPrefs">
        <view class="me-row-icon">◇</view>
        <view class="me-row-label">{{copy.prefs}}</view>
        <view wx:if="{{hasPrefs}}" class="me-row-badge">✓ {{copy.set}}</view>
        <view wx:else class="me-row-value">{{copy.unset}}</view>
        <view class="me-row-arrow">›</view>
      </view>
      <view class="me-row" bindtap="openHistory">
        <view class="me-row-icon">≡</view>
        <view class="me-row-label">{{copy.history}}</view>
        <view class="me-row-arrow">›</view>
      </view>

    </view>

    <view class="me-card">
      <view class="me-row" bindtap="openH5">
        <view class="me-row-icon">↗</view>
        <view class="me-row-label">{{copy.website}}</view>
        <view class="me-row-arrow">›</view>
      </view>
      <view class="me-row" bindtap="about">
        <view class="me-row-icon">i</view>
        <view class="me-row-label">{{copy.about}}</view>
        <view class="me-row-arrow">›</view>
      </view>
    </view>

    <button class="btn-ghost logout-btn" bindtap="doLogout">{{copy.logout}}</button>

    <view class="me-footer">WanderMind · 智旅 v1.0.0</view>
  </view>

</view>
