/* pages/me/me.wxss */
.me-page { min-height: 100vh; padding: 30rpx; box-sizing: border-box; }

.me-empty {
  padding: 200rpx 0;
  text-align: center;
}
.me-avatar-empty {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 30rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E5E2DA;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #A06A17;
  font-size: 24rpx;
  font-weight: 800;
}
.me-empty-text {
  font-size: 28rpx;
  color: #8A857F;
  margin-bottom: 40rpx;
}

.me-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 16rpx 40rpx;
}
.me-avatar {
  width: 100rpx; height: 100rpx;
  background: #0E7C6B;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 40rpx;
  font-weight: 700;
}
.me-info { flex: 1; min-width: 0; overflow-wrap: break-word; }
.me-avatar, .me-row-icon, .me-row-arrow { flex-shrink: 0; }
.me-name { font-size: 36rpx; font-weight: 700; color: #2A2723; }
.me-email { font-size: 24rpx; color: #8A857F; margin-top: 4rpx; }

.me-card {
  background: #fff;
  border: 1rpx solid #E5E2DA;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}
.me-row {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #F0EDE6;
  gap: 16rpx;
}
.me-row:last-child { border-bottom: none; }
.me-row-icon { display:flex; width:50rpx; height:50rpx; align-items:center; justify-content:center; border-radius:13rpx; background:#F3F1EA; color:#0E6658; font-size:21rpx; font-weight:800; }
.me-row-label { min-width: 0; flex: 1; font-size: 28rpx; color: #2A2723; }
.me-row-value { flex:0 1 auto; max-width: 45%; overflow-wrap: break-word; font-size: 24rpx; color: #8A857F; }
.me-row-badge {
  font-size: 22rpx;
  color: #0E7C6B;
  background: #E3F5F1;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-weight: 600;
}
.me-row-arrow { color: #C0C0C0; font-size: 32rpx; }

.logout-btn {
  width:100%;
  min-height:88rpx;
  margin-top: 20rpx;
}
.me-row:active { background:#F8F6F1; }
.food-row { width:100%; margin:0; min-height:44px; box-sizing:border-box; border-radius:0; background:transparent; line-height:normal; text-align:left; }
.food-row::after { border:0; }
.dining-icon { position:relative; width:30rpx; height:30rpx; }
.dining-plate { position:absolute; right:0; top:2rpx; width:20rpx; height:20rpx; border:2rpx solid currentColor; border-radius:50%; }
.dining-fork { position:absolute; left:0; top:0; width:3rpx; height:30rpx; background:currentColor; }
.dining-fork::before { content:''; position:absolute; top:0; left:-3rpx; width:7rpx; height:9rpx; border:2rpx solid currentColor; border-top:0; }
.me-footer {
  text-align: center;
  font-size: 22rpx;
  color: #C0C0C0;
  padding: 50rpx 0 30rpx;
}
