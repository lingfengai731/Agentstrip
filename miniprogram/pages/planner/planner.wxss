.planner-page{min-height:100vh;padding:28rpx 24rpx 260rpx;background:#faf7f2;color:#26342f;box-sizing:border-box}.intro{padding:34rpx 30rpx}.eyebrow{font-size:20rpx;font-weight:800;letter-spacing:.16em;color:#9a5d11}.title{margin-top:12rpx;font-size:43rpx;line-height:1.25;font-weight:850}.subtitle{margin-top:14rpx;color:#66716d;font-size:25rpx;line-height:1.65}.section{margin-top:20rpx;padding:30rpx;border:1rpx solid #e7dfd2;border-radius:28rpx;background:#fff}.section-title{font-size:31rpx;font-weight:800;margin-bottom:24rpx}.section-title text{display:inline-flex;width:46rpx;height:46rpx;margin-right:10rpx;align-items:center;justify-content:center;border-radius:50%;background:#173e37;color:#fff;font-size:20rpx}.label{margin:22rpx 0 10rpx;font-size:23rpx;font-weight:700;color:#4a5752}.segmented,.cards,.chips{display:flex;gap:12rpx;flex-wrap:wrap}.choice{flex:1;min-width:180rpx;padding:20rpx;border:1rpx solid #ded7ca;border-radius:999rpx;text-align:center;font-size:25rpx;font-weight:700}.choice.active,.mini-card.active,.chip.active{border-color:#0e7c6b;background:#eaf5f1;color:#0c6859}.three .choice{min-width:100rpx}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.field,.stepper{height:88rpx;padding:0 20rpx;border:1rpx solid #ddd5c8;border-radius:18rpx;display:flex;align-items:center;background:#fbfaf7;font-size:24rpx}.stepper{justify-content:space-between;padding:0 8rpx}.stepper button{width:66rpx;height:66rpx;margin:0;padding:0;line-height:66rpx;border-radius:50%;background:#fff;color:#0e7c6b;font-size:34rpx}.stepper button::after{border:0}.mini-card{flex:1;min-width:170rpx;padding:20rpx;border:1rpx solid #ded7ca;border-radius:20rpx}.mini-card b,.mini-card small{display:block}.mini-card b{font-size:25rpx}.mini-card small{margin-top:8rpx;color:#7a827e;font-size:20rpx;line-height:1.4}.chip{padding:16rpx 22rpx;border:1rpx solid #ded7ca;border-radius:999rpx;font-size:23rpx}.error{margin:20rpx 12rpx;color:#b23c2b;font-size:23rpx}.sticky-action{position:fixed;left:0;right:0;bottom:0;z-index:10;padding:18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);box-shadow:0 -12rpx 30rpx rgba(40,31,20,.09)}.summary{text-align:center;font-size:21rpx;color:#6d7571}.submit{margin-top:10rpx;height:92rpx;border-radius:46rpx;background:#f0b84d;color:#24322e;font-size:28rpx;font-weight:800}.submit::after{border:0}.benefit{text-align:center;margin-top:8rpx;color:#777e79;font-size:20rpx}
