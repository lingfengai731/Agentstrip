.planner-page { min-height: 100vh; padding: 26rpx 24rpx 270rpx; background: #FAFAF7; color: #26342F; box-sizing: border-box; }
.intro { padding: 30rpx 8rpx 24rpx; }
.title { font-size: 41rpx; line-height: 1.3; font-weight: 800; }
.subtitle { margin-top: 14rpx; max-width: 620rpx; color: #66716D; font-size: 24rpx; line-height: 1.65; }
.section { margin-top: 18rpx; padding: 28rpx; border: 1rpx solid #E7DFD2; border-radius: 22rpx; background: #FFFFFF; }
.section-title { display: flex; align-items: center; gap: 12rpx; margin-bottom: 22rpx; font-size: 30rpx; font-weight: 800; }
.step-index { display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border-radius: 12rpx; background: #173E37; color: #FCBF1E; font-size: 20rpx; }
.label { margin: 22rpx 0 10rpx; font-size: 23rpx; font-weight: 700; color: #4A5752; }
.segmented, .cards, .chips { display: flex; gap: 12rpx; flex-wrap: wrap; }
.choice { display: flex; min-height: 88rpx; flex: 1; min-width: 180rpx; padding: 0 20rpx; align-items: center; justify-content: center; border: 1rpx solid #DED7CA; border-radius: 18rpx; text-align: center; font-size: 25rpx; font-weight: 700; }
.choice.active, .mini-card.active, .chip.active { border-color: #0E7C6B; background: #EAF5F1; color: #0C6859; }
.three .choice { min-width: 100rpx; }
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.field, .stepper { display: flex; height: 88rpx; padding: 0 20rpx; align-items: center; border: 1rpx solid #DDD5C8; border-radius: 16rpx; background: #FBFAF7; box-sizing: border-box; font-size: 24rpx; }
.stepper { justify-content: space-between; padding: 0; overflow: hidden; }
.stepper button { display: flex; width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; align-items: center; justify-content: center; border-radius: 0; background: #FFFFFF; color: #0E7C6B; font-size: 34rpx; line-height: 1; }
.mini-card { display: flex; min-height: 118rpx; flex: 1; min-width: 170rpx; padding: 20rpx; flex-direction: column; justify-content: center; border: 1rpx solid #DED7CA; border-radius: 18rpx; box-sizing: border-box; }
.mini-card-title { font-size: 25rpx; font-weight: 750; }
.mini-card-copy { margin-top: 8rpx; color: #717A76; font-size: 20rpx; line-height: 1.4; }
.chip { display: flex; min-height: 80rpx; padding: 0 22rpx; align-items: center; justify-content: center; border: 1rpx solid #DED7CA; border-radius: 18rpx; font-size: 23rpx; }
.error { margin: 20rpx 12rpx; color: #B23C2B; font-size: 23rpx; }
.sticky-action { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 16rpx 26rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(250,250,247,.98); border-top: 1rpx solid #E5E2DA; }
.summary { text-align: center; font-size: 21rpx; color: #6D7571; }
.submit { display: flex; height: 92rpx; min-height: 92rpx; margin-top: 10rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #FCBF1E; color: #24322E; font-size: 28rpx; font-weight: 800; line-height: 1.2; }
.benefit { margin-top: 8rpx; color: #6F756F; font-size: 20rpx; text-align: center; }

@media (max-width: 360px) {
  .two-col { grid-template-columns: 1fr; gap: 0; }
  .cards { flex-direction: column; }
  .mini-card { width: 100%; }
}
