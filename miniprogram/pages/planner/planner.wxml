<view class="planner-page">
  <view class="intro">
    <view class="title">{{copy.title}}</view>
    <view class="subtitle">{{copy.subtitle}}</view>
  </view>

  <view class="section">
    <view class="section-title"><text class="step-index">1</text><text>{{copy.basic}}</text></view>
    <view class="label">{{copy.audience}} *</view>
    <view class="segmented">
      <view class="choice {{audience === 'first' ? 'active' : ''}}" bindtap="setChoice" data-field="audience" data-value="first"><text class="choice-mark">{{audience === 'first' ? '✓' : '○'}}</text>{{copy.first}}</view>
      <view class="choice {{audience === 'returning' ? 'active' : ''}}" bindtap="setChoice" data-field="audience" data-value="returning"><text class="choice-mark">{{audience === 'returning' ? '✓' : '○'}}</text>{{copy.returning}}</view>
    </view>
    <view class="two-col">
      <view><view class="label">{{copy.departure}} *</view><picker mode="date" value="{{departureDate}}" bindchange="onDeparture"><view class="field">{{departureDate}}</view></picker></view>
      <view><view class="label">{{copy.returnDate}} *</view><picker mode="date" value="{{returnDate}}" bindchange="onReturn"><view class="field">{{returnDate}}</view></picker></view>
    </view>
    <view class="two-col">
      <view><view class="label">{{copy.people}} *</view><view class="stepper"><button data-delta="-1" bindtap="changePeople">−</button><text>{{travellers}}</text><button data-delta="1" bindtap="changePeople">＋</button></view></view>
      <view><view class="label">{{copy.budget}} *</view><picker mode="selector" range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="onBudget"><view class="field">¥ {{budgetOptions[budgetIndex]}}</view></picker></view>
    </view>
  </view>

  <view class="section">
    <view class="section-title"><text class="step-index">2</text><text>{{copy.way}}</text></view>
    <view class="label">{{copy.style}} *</view>
    <view class="cards">
      <view class="mini-card {{travelStyle === 'comfort' ? 'active' : ''}}" bindtap="setChoice" data-field="travelStyle" data-value="comfort"><view class="mini-card-title">{{copy.comfort}}</view><view class="mini-card-copy">{{copy.comfortCopy}}</view></view>
      <view class="mini-card {{travelStyle === 'deep' ? 'active' : ''}}" bindtap="setChoice" data-field="travelStyle" data-value="deep"><view class="mini-card-title">{{copy.deep}}</view><view class="mini-card-copy">{{copy.deepCopy}}</view></view>
      <view class="mini-card {{travelStyle === 'resort' ? 'active' : ''}}" bindtap="setChoice" data-field="travelStyle" data-value="resort"><view class="mini-card-title">{{copy.resort}}</view><view class="mini-card-copy">{{copy.resortCopy}}</view></view>
    </view>
    <view class="label">{{copy.pace}} *</view>
    <view class="segmented three">
      <view class="choice {{pace === 'relaxed' ? 'active' : ''}}" bindtap="setChoice" data-field="pace" data-value="relaxed"><text class="choice-mark">{{pace === 'relaxed' ? '✓' : '○'}}</text>{{copy.relaxed}}</view>
      <view class="choice {{pace === 'balanced' ? 'active' : ''}}" bindtap="setChoice" data-field="pace" data-value="balanced"><text class="choice-mark">{{pace === 'balanced' ? '✓' : '○'}}</text>{{copy.balanced}}</view>
      <view class="choice {{pace === 'active' ? 'active' : ''}}" bindtap="setChoice" data-field="pace" data-value="active"><text class="choice-mark">{{pace === 'active' ? '✓' : '○'}}</text>{{copy.active}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title"><text class="step-index">3</text><text>{{copy.goals}}</text></view>
    <view class="label">{{copy.limit}} *</view>
    <view class="chips"><view wx:for="{{goalOptions}}" wx:key="id" class="chip {{item.selected ? 'active' : ''}}" bindtap="toggleGoal" data-id="{{item.id}}">{{item.selected ? '✓ ' : ''}}{{item.label}}</view></view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="sticky-action">
    <view class="summary">{{days}} {{copy.days}} · {{travellers}} {{copy.guests}} · {{goals.length}} {{copy.selected}}</view>
    <button class="submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy ? copy.busy : copy.submit}}</button>
    <view class="benefit">{{copy.benefit}}</view>
  </view>
</view>
