/* pages/chat/chat.wxss */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FAF7F2;
}

/* —— 顶部目的地条 —— */
.dest-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx 16rpx;
  background: #FAFAF7;
  border-bottom: 1rpx solid #E5E2DA;
}
.dest-bar-flag { font-size: 38rpx; }
.dest-bar-info { flex: 1; }
.dest-bar-name { font-size: 28rpx; font-weight: 700; color: #2A2723; }
.dest-bar-hint { font-size: 20rpx; color: #8A857F; margin-top: 2rpx; }

.mode-toggle {
  display: flex;
  gap: 4rpx;
  background: #ECE9E2;
  border-radius: 14rpx;
  padding: 4rpx;
}
.mode-btn {
  display: flex;
  min-width: 76rpx;
  min-height: 80rpx;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 700;
  color: #8A857F;
  border-radius: 11rpx;
}
.mode-btn.active { background: #FFFFFF; color: #075E52; box-shadow: 0 2rpx 6rpx rgba(42,39,35,.05); }

/* —— 消息流 —— */
.messages {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx;
  box-sizing: border-box;
}

/* —— 欢迎语 —— */
.welcome {
  padding: 54rpx 8rpx 32rpx;
}
.welcome-mark { display:flex; width:68rpx; height:68rpx; align-items:center; justify-content:center; margin-bottom:20rpx; border:1rpx solid #E5E2DA; border-radius:18rpx; background:#FFFFFF; font-size:38rpx; }
.welcome-title { font-size: 34rpx; font-weight: 750; color: #2A2723; margin-bottom: 8rpx; }
.welcome-hint { max-width: 580rpx; font-size: 24rpx; line-height: 1.6; color: #6F6962; margin-bottom: 34rpx; }
.sugg-list { display: flex; flex-direction: column; gap: 16rpx; }
.sugg-chip {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  background: #fff;
  border: 1rpx solid #E5E2DA;
  border-radius: 16rpx;
  padding: 14rpx 22rpx;
  font-size: 26rpx;
  color: #2A2723;
  text-align: left;
}

/* —— 单条消息 —— */
.msg {
  margin-bottom: 24rpx;
  display: flex;
}
.msg.user { justify-content: flex-end; }
.msg.assistant { justify-content: flex-start; }
.msg-bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  position: relative;
  box-sizing: border-box;
}
.msg.user .msg-bubble {
  background: #075E52;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.msg.assistant .msg-bubble {
  max-width: 88%;
  background: #fff;
  color: #2A2723;
  border-bottom-left-radius: 6rpx;
  border: 1rpx solid #E8E4DC;
  box-shadow: 0 3rpx 10rpx rgba(42,39,35,.03);
}
.msg-text {
  white-space: pre-wrap;
  word-break: break-word;
}
.msg-block {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}
.msg-block:first-of-type { margin-top: 0; }
.msg-block-heading {
  margin-top: 24rpx;
  color: #075E52;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}
.msg-block-paragraph,
.msg-block-quote {
  line-height: 1.65;
}
.msg-block-list {
  gap: 12rpx;
  line-height: 1.6;
}
.msg-block-quote {
  padding-left: 16rpx;
  border-left: 1rpx solid #D29B42;
  background: #FFFAEF;
  color: #5F5A54;
}
.msg-list-marker {
  flex: 0 0 auto;
  min-width: 24rpx;
  color: #C3841D;
  font-weight: 700;
}
.msg-block-text {
  min-width: 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.msg-search-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #53635E;
  background: #EEF3F0;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}
.msg-mode-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 1rpx solid #E1DCD3;
  border-radius: 10rpx;
  width: 38rpx;
  height: 34rpx;
  font-size: 18rpx;
  line-height: 1;
}
.msg-mode-badge.fast { color: #E07A12; }
.msg-mode-badge.pro  { color: #0E7C6B; }

/* —— 正在思考动画 —— */
.typing {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
}
.typing .dot {
  width: 12rpx;
  height: 12rpx;
  background: #8A857F;
  border-radius: 50%;
  animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing .dot:nth-child(2) { animation-delay: .2s; }
.typing .dot:nth-child(3) { animation-delay: .4s; }
@keyframes typing-bounce {
  0%, 80%, 100% { opacity: .3; transform: scale(.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* —— 输入区 —— */
.input-area {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FAFAF7;
  border-top: 1rpx solid #E1DCD3;
}
.composer { display: flex; align-items: flex-end; gap: 16rpx; }
.save-notice { margin-bottom: 10rpx; color: #7A5A22; font-size: 21rpx; }
.retry-btn {
  display: inline-flex;
  min-height: 80rpx;
  align-items: center;
  justify-content: center;
  margin: 0 0 12rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid #D29B42;
  border-radius: 999rpx;
  background: #FFF7E8;
  color: #7A4A08;
  font-size: 22rpx;
  line-height: 1.2;
}
.retry-btn::after { border: 0; }
.input-box {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #E5E2DA;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  max-height: 180rpx;
  min-height: 60rpx;
}
.send-btn {
  min-width: 128rpx;
  min-height: 72rpx;
  background: #0E7C6B;
  color: #fff;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin: 0;
  line-height: 1.2;
}
.send-btn[disabled] { background: #C0C0C0 !important; color: #fff !important; }
.send-btn::after { border: none; }
