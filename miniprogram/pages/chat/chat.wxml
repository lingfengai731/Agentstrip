<!--pages/chat/chat.wxml — AI 对话页-->
<view class="chat-page">

  <!-- 顶部目的地标签 -->
  <view class="dest-bar">
    <view class="dest-bar-flag">{{destFlag}}</view>
    <view class="dest-bar-info">
      <view class="dest-bar-name">{{destName}}</view>
      <view class="dest-bar-hint">{{copy.advisor}} · {{modeLabel}}</view>
    </view>
    <view class="mode-toggle">
      <view class="mode-btn {{mode === 'fast' ? 'active' : ''}}" bindtap="setMode" data-mode="fast">{{copy.fast}}</view>
      <view class="mode-btn {{mode === 'pro' ? 'active' : ''}}" bindtap="setMode" data-mode="pro">{{copy.deep}}</view>
    </view>
  </view>

  <!-- 消息流 -->
  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollAnchor}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <!-- 欢迎语 -->
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <view class="welcome-mark">{{destFlag}}</view>
      <view class="welcome-title">{{copy.welcome}}</view>
      <view class="welcome-hint">{{destName}} · {{copy.hint}}</view>
      <view class="sugg-list">
        <view
          wx:for="{{suggestions}}"
          wx:key="*this"
          class="sugg-chip"
          bindtap="quickSend"
          data-text="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <!-- 对话消息 -->
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="msg {{item.role}}"
    >
      <view class="msg-bubble">
        <view wx:if="{{item.role === 'assistant' && item.searched}}" class="msg-search-badge">{{copy.searched}}</view>
        <block wx:if="{{item.role === 'assistant'}}">
          <view
            wx:for="{{item.renderBlocks}}"
            wx:key="id"
            wx:for-item="block"
            class="msg-block msg-block-{{block.type}}"
          >
            <text wx:if="{{block.type === 'list'}}" class="msg-list-marker">{{block.marker}}</text>
            <text class="msg-block-text" user-select="{{true}}">{{block.text}}</text>
          </view>
        </block>
        <text wx:else class="msg-text">{{item.content}}</text>
        <view wx:if="{{item.role === 'assistant'}}" class="msg-mode-badge {{item.mode}}">{{item.mode === 'fast' ? copy.fast : copy.deep}}</view>
      </view>
    </view>

    <!-- 正在思考 -->
    <view wx:if="{{busy}}" id="msg-typing" class="msg assistant">
      <view class="msg-bubble">
        <view class="typing">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="input-area">
    <view wx:if="{{saveError}}" class="save-notice">{{saveError}}</view>
    <button wx:if="{{retryText}}" class="retry-btn" bindtap="retryLast">{{copy.retry}}</button>
    <view class="composer">
    <textarea
      class="input-box"
      placeholder="{{copy.input}}"
      placeholder-class="textarea-ph"
      placeholder-style="color:#B0A89D;font-size:28rpx;"
      value="{{inputText}}"
      bindinput="onInputChange"
      auto-height
      maxlength="500"
      cursor-spacing="20"
      adjust-position="{{true}}"
      show-confirm-bar="{{false}}"
    />
    <button class="send-btn" bindtap="sendMsg" disabled="{{busy || !canSend}}">
      {{busy ? copy.sending : copy.send}}
    </button>
    </view>
  </view>

</view>
