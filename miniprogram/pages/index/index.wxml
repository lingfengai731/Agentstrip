<!--pages/index/index.wxml — 首页：登录 + 目的地选择-->
<view class="page">

  <!-- 未登录：显示登录/注册卡片 -->
  <view wx:if="{{!loggedIn}}" class="auth-section">
    <view class="hero">
      <view class="hero-logo"><image src="/assets/logo-mark.png" mode="aspectFit" /></view>
      <view class="hero-title">WanderMind</view>
      <view class="hero-subtitle">{{copy.hero}}</view>
    </view>

    <view class="card auth-card">
      <view class="auth-tabs">
        <view class="auth-tab {{authMode === 'login' ? 'active' : ''}}" bindtap="switchAuth" data-mode="login">{{copy.login}}</view>
        <view class="auth-tab {{authMode === 'register' ? 'active' : ''}}" bindtap="switchAuth" data-mode="register">{{copy.register}}</view>
      </view>

      <view wx:if="{{authMode === 'register'}}" class="form-row">
        <view class="field-label">{{copy.name}}</view>
        <input class="input-base" placeholder-class="input-ph" placeholder="{{copy.nameHint}}" value="{{regName}}" bindinput="onInput" data-field="regName" />
      </view>
      <view class="form-row">
        <view class="field-label">{{copy.email}}</view>
        <input class="input-base" placeholder-class="input-ph" placeholder="name@example.com" type="text" value="{{email}}" bindinput="onInput" data-field="email" />
      </view>
      <view wx:if="{{authMode === 'register'}}" class="form-row code-row">
        <view class="code-field">
          <view class="field-label">{{copy.code}}</view>
          <input class="input-base code-input" placeholder-class="input-ph" placeholder="{{copy.codeHint}}" type="number" maxlength="6" value="{{verificationCode}}" bindinput="onInput" data-field="verificationCode" />
        </view>
        <button class="code-btn" bindtap="sendCode" loading="{{codeBusy}}" disabled="{{codeBusy || codeCooldown > 0}}">{{codeCooldown > 0 ? codeCooldown + ' s' : copy.sendCode}}</button>
      </view>
      <view class="form-row">
        <view class="field-label">{{copy.password}}</view>
        <input class="input-base" placeholder-class="input-ph" placeholder="{{copy.passwordHint}}" password value="{{password}}" bindinput="onInput" data-field="password" />
      </view>

      <button class="btn auth-btn" bindtap="doAuth" loading="{{authBusy}}" disabled="{{authBusy}}">
        {{authMode === 'login' ? copy.login : copy.register}}
      </button>

      <view class="auth-divider"><view></view><text>{{copy.or}}</text><view></view></view>
      <button class="wechat-btn" bindtap="wechatLogin" loading="{{wechatBusy}}" disabled="{{wechatBusy || authBusy}}">
        <text class="wechat-mark">W</text>
        {{wechatBusy ? copy.wechatBusy : copy.wechatLogin}}
      </button>
      <view class="wechat-login-hint">{{copy.linkHint}}</view>

      <view wx:if="{{authMode === 'register'}}" class="code-hint">{{copy.expiry}}</view>

      <view wx:if="{{authError}}" class="auth-error">{{authError}}</view>
    </view>
  </view>

  <!-- 已登录：显示目的地选择 + 快速入口 -->
  <view wx:if="{{loggedIn}}" class="dest-section">
    <view class="welcome">
      <view class="welcome-greeting">{{copy.hello}}{{user.name}}</view>
      <view class="welcome-sub">{{copy.where}}</view>
    </view>

    <view class="dest-grid">
      <view
        wx:for="{{destinations}}"
        wx:key="id"
        class="dest-card {{currentDest === item.id ? 'active' : ''}}"
        bindtap="selectDest"
        data-id="{{item.id}}"
      >
        <view class="dest-symbol"><image src="/assets/nav/discover-active.png" mode="aspectFit" aria-hidden="true" /></view>
        <view class="dest-info">
          <view class="dest-name">{{item.name}}</view>
          <view class="dest-region">{{item.region}}</view>
        </view>
        <view wx:if="{{currentDest === item.id}}" class="dest-check">✓</view>
      </view>
    </view>

    <view wx:if="{{showFutureDestinations}}" class="card custom-dest-card" bindtap="customDest">
      <view class="custom-icon">＋</view>
      <view class="custom-text">{{copy.other}}</view>
      <view class="custom-arrow">›</view>
    </view>

    <view wx:if="{{!wechatLinked}}" class="card wechat-link-card">
      <view class="wechat-link-copy">
        <view class="wechat-link-title">{{copy.linkTitle}}</view>
        <view class="wechat-link-subtitle">{{copy.linkCopy}}</view>
      </view>
      <button class="wechat-link-btn" bindtap="linkWechat" loading="{{wechatBusy}}" disabled="{{wechatBusy}}">{{copy.link}}</button>
    </view>
    <view wx:if="{{wechatLinked}}" class="wechat-linked-note">{{copy.linked}}</view>

    <view class="quick-actions">
      <view class="qa-title">{{copy.start}}</view>
      <view class="qa-grid">
        <view class="qa-item" bindtap="goChat">
          <view class="qa-icon"><image src="/assets/nav/ask-active.png" mode="aspectFit" aria-hidden="true" /></view>
          <view class="qa-copy"><view class="qa-label">{{copy.ask}}</view><view class="qa-note">{{copy.advice}}</view></view>
        </view>
        <view class="qa-item" bindtap="goCompare">
          <view class="qa-icon"><image src="/assets/nav/prices-active.png" mode="aspectFit" aria-hidden="true" /></view>
          <view class="qa-copy"><view class="qa-label">{{copy.compare}}</view><view class="qa-note">{{copy.options}}</view></view>
        </view>
        <view class="qa-item" bindtap="goItinerary">
          <view class="qa-icon"><image src="/assets/nav/trips-active.png" mode="aspectFit" aria-hidden="true" /></view>
          <view class="qa-copy"><view class="qa-label">{{copy.trips}}</view><view class="qa-note">{{copy.continue}}</view></view>
        </view>
        <view class="qa-item" bindtap="goMe">
          <view class="qa-icon"><image src="/assets/nav/me-active.png" mode="aspectFit" aria-hidden="true" /></view>
          <view class="qa-copy"><view class="qa-label">{{copy.prefs}}</view><view class="qa-note">{{copy.habits}}</view></view>
        </view>
      </view>
    </view>

    <view class="portfolio-card" bindtap="openGallery" hover-class="portfolio-pressed" hover-stay-time="90">
      <view class="portfolio-kicker">BALI PORTFOLIO</view>
      <view class="portfolio-title">{{copy.moments}}</view>
      <view class="portfolio-copy">{{copy.galleryCopy}}</view>
      <view class="portfolio-action">{{copy.gallery}} <text>→</text></view>
    </view>

    <view class="logout-row"><button class="logout-link" bindtap="doLogout">{{copy.logout}}</button></view>
  </view>

</view>
