/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
}

/* —— Hero (登录页头部) —— */
.hero {
  text-align: center;
  padding: 44rpx 0 32rpx;
}
.hero-logo {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 24rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E5E2DA;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 30rpx rgba(42,39,35,.06);
}
.hero-logo image { width: 72rpx; height: 72rpx; }
.hero-title {
  font-size: 42rpx;
  font-weight: 750;
  letter-spacing: -.5rpx;
  color: #2A2723;
}
.hero-subtitle {
  font-size: 24rpx;
  color: #6F6962;
  margin: 10rpx auto 0;
  max-width: 560rpx;
  line-height: 1.55;
}

/* —— 登录卡片 —— */
.auth-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx 28rpx;
}
.auth-tabs {
  display: flex;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #E1DCD3;
}
.auth-tab {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 0;
  font-size: 30rpx;
  color: #8A857F;
  font-weight: 600;
  border-bottom: 4rpx solid transparent;
  margin-bottom: -1rpx;
}
.auth-tab.active {
  color: #0E7C6B;
  border-bottom-color: #0E7C6B;
}
.form-row {
  margin-bottom: 20rpx;
}
.field-label { margin: 0 4rpx 9rpx; color: #4F4A45; font-size: 22rpx; font-weight: 700; }
.code-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.code-field { flex: 1; min-width: 0; }
.code-input {
  flex: 1;
  min-width: 0;
}
.code-btn {
  width: 220rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #E3F5F1;
  color: #0E6658;
  font-size: 24rpx;
  font-weight: 700;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 1.2;
}
.code-btn::after { border: 0; }
.code-btn[disabled] { color: #8A857F; background: #F0EDE6; }
.code-hint {
  margin-top: 16rpx;
  color: #6F6962;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
.auth-btn {
  margin-top: 10rpx;
}
.auth-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
  color: #A39B91;
  font-size: 22rpx;
}
.auth-divider view {
  flex: 1;
  height: 1rpx;
  background: #E1DCD3;
}
.wechat-btn,
.wechat-link-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #B6D9D1;
  border-radius: 14rpx;
  background: #F5FBF9;
  color: #0E6658;
  font-size: 28rpx;
  font-weight: 700;
  min-height: 88rpx;
  line-height: 1.2;
}
.wechat-btn::after,
.wechat-link-btn::after { border: 0; }
.wechat-btn[disabled],
.wechat-link-btn[disabled] { opacity: .58; }
.wechat-mark {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #0E7C6B;
  color: #FAF7F2;
  font-size: 23rpx;
  line-height: 1;
}
.wechat-login-hint {
  margin-top: 12rpx;
  color: #8A857F;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}
.auth-error {
  margin-top: 20rpx;
  color: #C13B3B;
  font-size: 24rpx;
  text-align: center;
}

/* —— 已登录：欢迎区 —— */
.welcome {
  padding: 28rpx 4rpx 26rpx;
}
.welcome-greeting {
  font-size: 38rpx;
  font-weight: 700;
  color: #2A2723;
}
.welcome-sub {
  font-size: 26rpx;
  color: #8A857F;
  margin-top: 6rpx;
}

/* —— 目的地卡片网格 —— */
.dest-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.dest-card {
  background: #fff;
  border: 1rpx solid #E5E2DA;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(42,39,35,.035);
  transition: transform .15s;
}
.dest-card.active {
  border-color: #0E7C6B;
  background: #E3F5F1;
}
.dest-card:active, .custom-dest-card:active, .qa-item:active { transform: scale(.985); }
.dest-flag {
  font-size: 56rpx;
}
.dest-info {
  flex: 1;
}
.dest-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2A2723;
}
.dest-region {
  font-size: 22rpx;
  color: #8A857F;
  margin-top: 4rpx;
}
.dest-check {
  color: #0E7C6B;
  font-size: 36rpx;
  font-weight: 700;
}

/* —— 自定义目的地 —— */
.custom-dest-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
}
.custom-icon { display:flex; width:52rpx; height:52rpx; align-items:center; justify-content:center; border-radius:14rpx; background:#F3F1EA; color:#0E6658; font-size:32rpx; }
.custom-text { flex: 1; font-size: 28rpx; color: #2A2723; font-weight: 600; }
.custom-arrow { color: #8A857F; font-size: 40rpx; }

.wechat-link-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
}
.wechat-link-copy { flex: 1; min-width: 0; }
.wechat-link-title {
  color: #2A2723;
  font-size: 28rpx;
  font-weight: 700;
}
.wechat-link-subtitle {
  margin-top: 6rpx;
  color: #8A857F;
  font-size: 21rpx;
  line-height: 1.45;
}
.wechat-link-btn {
  flex: 0 0 132rpx;
  width: 132rpx;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
  min-height: 88rpx;
  height: 88rpx;
  line-height: 1.2;
}
.wechat-linked-note {
  margin-top: 24rpx;
  color: #0E7C6B;
  font-size: 22rpx;
  text-align: center;
}

/* —— 快速入口 —— */
.quick-actions {
  margin-top: 30rpx;
}
.qa-title {
  font-size: 24rpx;
  color: #8A857F;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin: 0 10rpx 16rpx;
}
.qa-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.qa-item {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  background: #fff;
  border: 1rpx solid #E5E2DA;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  text-align: left;
  box-shadow: 0 4rpx 14rpx rgba(42,39,35,.035);
}
.qa-icon {
  display: flex;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin-right: 16rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #173E37;
  color: #FCBF1E;
  font-size: 22rpx;
  font-weight: 800;
}
.qa-copy { min-width: 0; }
.qa-label {
  font-size: 26rpx;
  color: #2A2723;
  font-weight: 700;
}
.qa-note { margin-top: 3rpx; color: #8A857F; font-size: 20rpx; line-height: 1.35; }

@media (max-width: 360px) {
  .qa-grid { grid-template-columns: 1fr; gap: 14rpx; }
}

/* —— 退出登录 —— */
.logout-row {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.logout-link {
  width: 220rpx;
  min-height: 88rpx;
  margin: 0 auto;
  background: transparent;
  color: #8A857F;
  font-size: 24rpx;
  text-decoration: underline;
}
.logout-link::after { border: 0; }
