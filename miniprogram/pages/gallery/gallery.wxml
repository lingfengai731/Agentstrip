<view class="gallery-page">
  <view class="gallery-intro">
    <view class="eyebrow">WANDERMIND PORTFOLIO</view>
    <view class="gallery-title">{{copy.galleryTitle}}</view>
    <view class="gallery-subtitle">{{copy.gallerySub}}</view>
    <view class="gallery-summary"><text>{{totalCount}} {{copy.count}}</text><text>{{copy.saveHint}}</text><text>{{copy.tapHint}}</text></view>
  </view>

  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <button wx:for="{{filters}}" wx:key="id" class="filter-chip {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseFilter">{{item.label}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state-card">{{copy.galleryLoading}}</view>
  <view wx:if="{{error}}" class="state-card error"><text>{{error}}</text><button class="retry" bindtap="retry">{{copy.reload}}</button></view>
  <view wx:if="{{!loading && !error && !visibleAssets.length}}" class="state-card">{{copy.emptyGallery}}</view>

  <view wx:if="{{visibleAssets.length}}" class="gallery-grid">
    <view wx:for="{{visibleAssets}}" wx:key="key" class="gallery-card" data-index="{{index}}" bindtap="openAsset" hover-class="card-pressed" hover-stay-time="90">
      <image wx:if="{{!item.imageFailed}}" class="gallery-image" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load show-menu-by-longpress="{{true}}" data-key="{{item.key}}" binderror="markImageFailed" />
      <view wx:else class="gallery-image image-fallback">{{copy.imageFailed}}</view>
      <view class="gallery-copy">
        <view class="gallery-place">{{item.placeName || item.region || 'Bali'}}</view>
        <view class="gallery-card-title">{{item.title}}</view>
        <view class="gallery-meta">{{item.primaryPoiId ? copy.viewPlace : copy.viewPhoto}}</view>
      </view>
    </view>
  </view>
  <view wx:if="{{visibleAssets.length}}" class="gallery-count">{{visibleCount}} {{copy.count}}</view>
</view>
