.language-page { min-height: 100vh; padding: 34rpx 24rpx; background: #FAFAF7; box-sizing: border-box; color: #26342F; }
.header { padding: 28rpx 12rpx 30rpx; }
.title { font-size: 42rpx; line-height: 1.3; font-weight: 800; }
.subtitle { margin-top: 12rpx; color: #757D78; font-size: 24rpx; line-height: 1.55; }
.language-list { display: flex; flex-direction: column; gap: 14rpx; }
.language { display: flex; min-height: 92rpx; align-items: center; gap: 18rpx; padding: 14rpx 24rpx; border: 1rpx solid #E4DDD1; border-radius: 20rpx; background: #FFFFFF; box-sizing: border-box; }
.language.active { border-color: #0E7C6B; background: #EDF7F3; }
.language-mark { display:flex; flex:0 0 52rpx; width:52rpx; height:52rpx; align-items:center; justify-content:center; border-radius:14rpx; background:#F3F1EA; color:#0E6658; font-size:21rpx; font-weight:800; letter-spacing:.02em; }
.language.active .language-mark { background:#FFFFFF; }
.label { min-width: 0; flex: 1; font-size: 28rpx; font-weight: 700; }
.check { flex: 0 0 36rpx; color: #0E7C6B; font-size: 30rpx; font-weight: 800; text-align: center; }
.language { min-height: 44px; }
.label, .title, .subtitle { overflow-wrap: break-word; }
