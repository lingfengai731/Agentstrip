.language-page{min-height:100vh;padding:34rpx 24rpx;background:#faf7f2;box-sizing:border-box;color:#26342f}.header{padding:30rpx 16rpx}.eyebrow{font-size:20rpx;letter-spacing:.16em;font-weight:800;color:#986015}.title{margin-top:10rpx;font-size:42rpx;font-weight:850}.subtitle{margin-top:12rpx;color:#757d78;font-size:24rpx;line-height:1.55}.language-list{display:flex;flex-direction:column;gap:14rpx}.language{display:flex;align-items:center;gap:18rpx;padding:28rpx;border:1rpx solid #e4ddd1;border-radius:24rpx;background:#fff}.language.active{border-color:#0e7c6b;background:#edf7f3}.flag{font-size:42rpx}.label{flex:1;font-size:28rpx;font-weight:700}.check{color:#0e7c6b;font-size:30rpx;font-weight:800}
