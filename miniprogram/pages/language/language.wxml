<view class="language-page">
  <view class="header">
    <view class="title">选择你的语言</view>
    <view class="subtitle">路线名称、规划回复与底部导航会同步更新。</view>
  </view>
  <view class="language-list">
    <view wx:for="{{languages}}" wx:key="id" class="language {{current === item.id ? 'active' : ''}}" bindtap="choose" data-id="{{item.id}}">
      <view class="flag">{{item.flag}}</view>
      <view class="label">{{item.label}}</view>
      <view class="check">{{current === item.id ? '✓' : ''}}</view>
    </view>
  </view>
</view>
