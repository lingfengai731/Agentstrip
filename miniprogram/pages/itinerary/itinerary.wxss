.route-page { min-height: 100vh; padding: 24rpx 24rpx 80rpx; background: #FAFAF7; box-sizing: border-box; color: #24332F; }
.route-hero { position: relative; overflow: hidden; padding: 38rpx 34rpx; border: 1rpx solid rgba(255,255,255,.14); border-radius: 26rpx; color: #FFFFFF; background: #173E37; box-shadow: 0 14rpx 34rpx rgba(18,72,62,.14); }
.route-hero::after { position: absolute; right: -42rpx; bottom: -70rpx; width: 180rpx; height: 180rpx; border: 18rpx solid rgba(252,191,30,.18); border-radius: 50%; content: ""; }
.route-stamp { display: flex; width: 68rpx; height: 46rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(252,191,30,.62); border-radius: 12rpx; color: #FCBF1E; font-size: 18rpx; font-weight: 800; letter-spacing: .08em; }
.route-title { position: relative; z-index: 1; margin-top: 14rpx; font-size: 46rpx; line-height: 1.2; font-weight: 800; }
.route-sub { position: relative; z-index: 1; margin-top: 18rpx; max-width: 590rpx; font-size: 26rpx; line-height: 1.65; color: rgba(255,255,255,.84); }
.hero-actions, .pro-actions { position: relative; z-index: 1; display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 28rpx; }
.btn { display: flex; min-height: 88rpx; margin: 0; padding: 0 28rpx; align-items: center; justify-content: center; border-radius: 44rpx; font-size: 26rpx; font-weight: 700; line-height: 1.2; }
.btn.primary { background: #FCBF1E; color: #23312D; }
.btn.ghost { background: rgba(255,255,255,.08); color: #FFFFFF; border: 1rpx solid rgba(255,255,255,.42); }
.btn.full { width: 100%; margin-top: 24rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin: 48rpx 8rpx 22rpx; }
.section-title { font-size: 34rpx; line-height: 1.35; font-weight: 800; }
.section-note { max-width: 220rpx; text-align: right; color: #747B77; font-size: 20rpx; line-height: 1.4; }
.state-card, .public-card, .pro-card { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid #E6E0D5; border-radius: 24rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(56,45,28,.035); }
.state-card.error { color: #A23A2A; background: #FFF8F6; }
.text-btn { min-height: 80rpx; margin: 16rpx 0 0; background: transparent; color: #0E7C6B; font-size: 24rpx; }
.route-tabs { width: 100%; white-space: nowrap; }
.route-tabs-inner { display: inline-flex; gap: 14rpx; padding: 4rpx 2rpx 12rpx; }
.route-tab { display: inline-flex; min-height: 88rpx; gap: 10rpx; padding: 0 24rpx; align-items: center; justify-content: center; border: 1rpx solid #DDD5C7; border-radius: 999rpx; background: #FFFFFF; font-size: 24rpx; font-weight: 700; }
.route-tab.active { background: #173E37; color: #FFFFFF; border-color: #173E37; }
.public-title, .pro-title { font-size: 34rpx; line-height: 1.35; font-weight: 800; }
.public-promise, .pro-reason { margin-top: 12rpx; color: #65716D; font-size: 25rpx; line-height: 1.65; }
.route-facts { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 18rpx; }
.route-facts text { padding: 8rpx 14rpx; border-radius: 99rpx; background: #F1F6F3; color: #326356; font-size: 21rpx; }
.day-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.public-day, .pro-day { display: flex; gap: 18rpx; padding: 20rpx; border: 1rpx solid #EEE9E0; border-radius: 18rpx; background: #FBFAF7; }
.pro-day.locked { background: #F1EFEC; color: #909590; }
.day-number { display: flex; flex: 0 0 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 50%; background: #0E7C6B; color: #FFFFFF; font-size: 22rpx; font-weight: 800; }
.locked .day-number { background: #A7AAA6; }
.day-body { min-width: 0; flex: 1; }
.day-title { font-size: 25rpx; font-weight: 750; }
.day-theme, .places, .lock-copy { margin-top: 8rpx; font-size: 22rpx; line-height: 1.55; color: #6B756F; }
.places { color: #365F54; }
.place-links { display: flex; gap: 10rpx; flex-wrap: wrap; }
.place-link { display: inline-flex; min-height: 72rpx; margin: 0; padding: 0 18rpx; align-items: center; gap: 10rpx; border: 1rpx solid #D7E2DD; border-radius: 999rpx; background: #FFFFFF; color: #285B50; font-size: 22rpx; line-height: 1.2; }
.place-link text { color: #9A731A; font-size: 18rpx; font-weight: 700; }
.gallery-link { display: flex; min-height: 72rpx; margin: 12rpx 0 0; padding: 0 22rpx; align-items: center; justify-content: center; border: 1rpx solid #D8C68F; border-radius: 999rpx; background: #FFF9E9; color: #725513; font-size: 22rpx; font-weight: 750; line-height: 1.2; }
.lock-copy { color: #8B8E8A; }
.pro-top { display: flex; justify-content: space-between; gap: 20rpx; }
.pro-heading { min-width: 0; }
.pro-label { margin-bottom: 8rpx; color: #8A6A2D; font-size: 20rpx; font-weight: 700; }
.status { flex: 0 0 auto; align-self: flex-start; padding: 8rpx 14rpx; border-radius: 99rpx; background: #FFF2D5; color: #8B5C08; font-size: 20rpx; font-weight: 800; }
.status.open { background: #E2F4EC; color: #0E6C5C; }
.allowance { width: 100%; font-size: 21rpx; color: #767C77; line-height: 1.5; }
.destination-notice { margin-top: 28rpx; padding: 34rpx; border: 1rpx solid #DED7CA; border-radius: 24rpx; background: #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(56,45,28,.05); }
.destination-notice-title { color: #173E37; font-size: 36rpx; font-weight: 800; line-height: 1.35; }
.destination-notice-copy { margin-top: 14rpx; color: #65716D; font-size: 25rpx; line-height: 1.65; }
.destination-notice-actions { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 28rpx; }
.destination-notice .btn.primary { background: #0E7C6B; color: #FFFFFF; }
.destination-notice .btn.secondary { border: 1rpx solid #D8C68F; background: #FFF9E9; color: #725513; }

@media (max-width: 360px) {
  .section-head { align-items: flex-start; flex-direction: column; gap: 8rpx; }
  .section-note { max-width: none; text-align: left; }
  .pro-top { flex-direction: column; gap: 12rpx; }
}

.route-page .place-link, .route-page .gallery-link, .route-page .text-btn { width: auto; min-height: 44px; max-width: 100%; padding-top: 12rpx; padding-bottom: 12rpx; white-space: normal; overflow-wrap: break-word; }
.route-page .place-link { flex-wrap: wrap; justify-content: flex-start; }
.route-page .hero-actions .btn { width: auto; max-width: 100%; padding-top: 14rpx; padding-bottom: 14rpx; }

/* Daily plans are the primary task; optional island days stay below them. */
.swipe-hint { margin:8rpx 4rpx; color:#65716D; font-size:22rpx; }
.public-card { padding:26rpx 22rpx; }
.public-day { display:block; padding:0; overflow:hidden; }
.day-toggle, .extension-toggle { display:flex; width:100%; min-height:44px; margin:0; padding:24rpx; gap:18rpx; background:transparent; color:#24332F; border-radius:0; text-align:left; justify-content:space-between; }
.day-heading { flex:1; min-width:0; }
.day-title { line-height:1.5; overflow-wrap:break-word; }
.day-disclosure { margin-top:4rpx; color:#65716D; font-size:21rpx; font-weight:400; }
.public-day .day-body { padding:0 22rpx 24rpx; }
.public-day .place-links { display:flex; flex-direction:column; gap:10rpx; }
.public-day .place-link { width:100%; padding:18rpx; border-radius:12rpx; justify-content:space-between; flex-wrap:nowrap; }
.public-day .place-name { flex:1; min-width:0; font-size:24rpx; line-height:1.5; color:#285B50; font-weight:500; }
.public-day .place-photo-label { flex-shrink:0; font-size:20rpx; }
.route-page .btn.secondary { width:100%; height:auto; min-height:44px; padding:18rpx 24rpx; border:1rpx solid #C7D8D1; border-radius:14rpx; background:#F1F6F3; color:#285B50; line-height:1.5; }
.extensions { margin-top:30rpx; border-top:1rpx solid #E6E0D5; }
.extension-toggle { padding:24rpx 0; gap:18rpx; font-size:25rpx; }
.extension-toggle text:first-child { flex:1; }
.extension-hint, .extension-summary { text-align:left; color:#65716D; font-size:23rpx; line-height:1.65; }
.extension-card { margin-top:20rpx; padding:24rpx; border:1rpx solid #E6E0D5; border-radius:16rpx; background:#FAFAF7; }
.extension-summary { margin:12rpx 0 20rpx; }
