<view class="route-page">
  <view wx:if="{{!isBali}}" class="destination-notice">
    <view class="destination-notice-title">{{copy.otherDestinationTitle}}</view>
    <view class="destination-notice-copy">{{destinationName}}{{copy.otherDestinationCopy}}</view>
    <view class="destination-notice-actions">
      <button class="btn primary" bindtap="goChat">{{copy.planDestination}}</button>
      <button class="btn secondary" bindtap="chooseBali">{{copy.switchToBali}}</button>
    </view>
  </view>

  <block wx:else>
  <view class="route-hero">
    <view class="route-stamp">BALI</view>
    <view class="route-title">{{copy.title}}</view>
    <view class="route-sub">{{copy.subtitle}}</view>
    <view class="hero-actions">
      <button class="btn primary" bindtap="openPlanner">{{copy.match}}</button>
      <button class="btn ghost" bindtap="goChat">{{copy.diy}}</button>
    </view>
  </view>

  <view wx:if="{{professionalError}}" class="state-card error"><text>{{copy.personal}} · {{professionalError}}</text><button bindtap="retryProfessional">{{copy.retry}}</button></view>
  <view wx:if="{{professional}}" class="pro-card">
    <view class="pro-top">
      <view class="pro-heading"><view class="pro-label">{{copy.personal}}</view><view class="pro-title">{{professional.route.route_name}}</view></view>
      <view class="status {{professional.route.unlocked ? 'open' : ''}}">{{professional.route.unlocked ? copy.unlocked : copy.preview}}</view>
    </view>
    <view class="pro-reason">{{professional.route.recommendation_reason}}</view>
    <view class="day-list">
      <view wx:for="{{professional.route.days_plan}}" wx:key="day" class="pro-day {{item.locked ? 'locked' : ''}}">
        <view class="day-number">{{item.day}}</view>
        <view class="day-body">
          <view class="day-title">{{copy.day}} {{item.day}} · {{item.region_name}}</view>
          <view class="day-theme">{{item.theme}}</view>
          <block wx:if="{{!item.locked}}">
            <view class="places place-links"><button wx:for="{{item.places}}" wx:key="id" class="place-link" data-id="{{item.id}}" data-route="{{professional.route.route_id}}" bindtap="openPlace">{{item.name}}<text>{{copy.photos}}</text></button></view>
            <view wx:for="{{item.restaurants}}" wx:for-item="restaurant" wx:key="id" class="day-theme">{{restaurant.name}}</view>
          </block>
          <view wx:else="" class="lock-copy">{{item.lock_reason}}</view>
        </view>
      </view>
    </view>
    <view class="pro-actions">
      <button wx:if="{{!professional.route.unlocked}}" class="btn primary" bindtap="copyUnlockLink">{{copy.unlock}}</button>
      <button wx:if="{{professional.route.unlocked}}" class="btn primary" bindtap="openDriver">{{copy.driver}}</button>
      <view class="allowance">{{professional.route.unlocked ? copy.remaining + professional.professional_adjustments_remaining : copy.price}}</view>
    </view>
  </view>

  <view class="section-head">
    <view><view class="section-title">{{copy.free}}</view><button class="gallery-link" bindtap="openGallery">{{copy.gallery}}</button></view>
    <view class="section-note">{{copy.hint}}</view>
  </view>
  <view wx:if="{{loading}}" class="state-card">{{copy.loading}}</view>
  <view wx:if="{{error}}" class="state-card error"><view>{{error}}</view><button class="text-btn" bindtap="retry">{{copy.retry}}</button></view>
  <scroll-view wx:if="{{routes.length}}" class="route-tabs" scroll-x enhanced show-scrollbar="{{false}}"><view class="route-tabs-inner"><view wx:for="{{routes}}" wx:key="id" class="route-tab {{selected.id === item.id ? 'active' : ''}}" bindtap="selectRoute" data-id="{{item.id}}" role="button" aria-label="{{item.name}}"><text>{{item.name}}</text></view></view></scroll-view>
  <view wx:if="{{routes.length}}" class="swipe-hint">{{layoutCopy.swipe}}</view>
  <view wx:if="{{selected}}" class="public-card">
    <view class="public-title">{{selected.name}}</view>
    <view class="public-promise">{{selected.promise}}</view>
    <view class="route-facts"><text>{{copy.recommended}}{{selected.idealDays}}</text><text>{{selected.regionPath}}</text></view>
    <view class="day-list public-days">
      <view wx:for="{{selected.days}}" wx:for-item="day" wx:key="day" class="public-day">
        <button class="day-toggle" data-day="{{day.index}}" bindtap="toggleDay" aria-expanded="{{openDay === day.index}}"><view class="day-number">{{day.day}}</view><view class="day-heading"><view class="day-title">{{day.theme}}</view><view class="day-disclosure">{{openDay === day.index ? layoutCopy.collapse : layoutCopy.expand}}</view></view><text>{{openDay === day.index ? '−' : '+'}}</text></button>
        <view wx:if="{{openDay === day.index}}" class="day-body">
          <view class="places place-links"><button wx:for="{{day.places}}" wx:key="id" class="place-link" data-id="{{item.id}}" data-route="{{selected.id}}" bindtap="openPlace"><text class="place-name">{{item.name}}</text><text class="place-photo-label">{{copy.photos}}</text></button></view>
          <view wx:for="{{day.food}}" wx:key="id" class="day-theme">{{item.meal}} · {{item.name}}</view>
          <button class="btn secondary full" bindtap="openFood" data-day="{{day.index}}">{{foodCopy.findFood}}</button>
        </view>
      </view>
    </view>
    <view wx:if="{{selected.modules.length}}" class="extensions">
      <button class="extension-toggle" bindtap="toggleModules" aria-expanded="{{extensionsOpen}}"><text>{{layoutCopy.extensions}}</text><text>{{extensionsOpen ? '−' : '+'}}</text></button>
      <block wx:if="{{extensionsOpen}}"><view class="extension-hint">{{layoutCopy.extensionHint}}</view><view wx:for="{{selected.modules}}" wx:key="id" class="extension-card"><view class="day-title">{{item.name}}</view><view class="extension-summary">{{item.summary}}</view><button class="btn secondary" data-id="{{item.id}}" bindtap="toggleExtension">{{item.selected ? layoutCopy.remove : layoutCopy.add}}</button></view></block>
    </view>
    <button class="btn primary full" bindtap="openPlanner">{{copy.use}}</button>
  </view>
  </block>
</view>
