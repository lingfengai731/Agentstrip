<!--pages/compare/compare.wxml — 酒店 + 机票比价-->
<view class="compare-page">

  <!-- 顶部：目的地 + 子 tab -->
  <view class="dest-bar">
    <view class="dest-icon"><image src="/assets/nav/prices-active.png" mode="aspectFit" aria-hidden="true" /></view>
    <view class="dest-info">
      <view class="dest-name">{{destName}}</view>
      <view class="dest-hint">{{copy.hint}}</view>
    </view>
  </view>

  <view class="sub-tabs">
    <view class="sub-tab {{tab === 'hotels' ? 'active' : ''}}" bindtap="switchTab" data-tab="hotels"><image src="/assets/nav/hotel.png" mode="aspectFit" aria-hidden="true" />{{copy.hotels}}</view>
    <view class="sub-tab {{tab === 'flights' ? 'active' : ''}}" bindtap="switchTab" data-tab="flights"><image src="/assets/nav/flight.png" mode="aspectFit" aria-hidden="true" />{{copy.flights}}</view>
  </view>

  <!-- ═══════════ 酒店 panel ═══════════ -->
  <view wx:if="{{tab === 'hotels'}}" class="panel">

    <!-- 住宿区域 chips -->
    <view class="form-section-label">{{copy.area}}</view>
    <scroll-view scroll-x enable-flex class="chips-row" show-scrollbar="{{false}}">
      <view
        wx:for="{{areas}}"
        wx:key="key"
        class="chip {{currentArea === item.key ? 'active' : ''}}"
        bindtap="selectArea"
        data-key="{{item.key}}"
      >{{item.name}}</view>
    </scroll-view>

    <!-- 日期 + 人数 -->
    <view class="form-row">
      <view class="field">
        <view class="field-label">{{copy.checkIn}}</view>
        <picker mode="date" value="{{hotelCheckIn}}" start="{{today}}" bindchange="onCheckIn">
          <view class="picker-display">{{hotelCheckIn}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">{{copy.checkOut}}</view>
        <picker mode="date" value="{{hotelCheckOut}}" start="{{today}}" bindchange="onCheckOut">
          <view class="picker-display">{{hotelCheckOut}}</view>
        </picker>
      </view>
    </view>
    <view class="form-row">
      <view class="field flex-1">
        <view class="field-label">{{copy.people}}</view>
        <picker mode="selector" range="{{adultsRange}}" value="{{hotelAdultsIdx}}" bindchange="onHotelAdults">
          <view class="picker-display">{{hotelAdultsIdx + 1}} {{hotelAdultsIdx === 0 ? copy.personOne : copy.person}}</view>
        </picker>
      </view>
    </view>

    <button class="search-btn" bindtap="searchHotelsHandler" loading="{{hotelBusy}}" disabled="{{hotelBusy}}">
      {{hotelBusy ? copy.searching : copy.searchHotels}}
    </button>

    <!-- 结果 -->
    <view wx:if="{{hotelResults.length > 0}}" class="results">
      <view
        wx:for="{{hotelResults}}"
        wx:key="name"
        class="hotel-card"
        bindtap="openHotelLink"
        data-link="{{item.link}}"
      >
        <image wx:if="{{item.thumbnail}}" src="{{item.thumbnail}}" class="hotel-thumb" mode="aspectFill" />
        <view wx:else class="hotel-thumb-placeholder"><image src="/assets/nav/hotel.png" mode="aspectFit" aria-hidden="true" /></view>
        <view class="hotel-info">
          <view class="hotel-name">{{item.name}}</view>
          <view class="hotel-meta">
            <text wx:if="{{item.rating}}" class="hotel-rating">{{copy.rating}} {{item.rating}}</text>
            <text wx:if="{{item.reviews}}" class="hotel-reviews">{{item.reviews}} {{copy.reviews}}</text>
          </view>
          <view class="hotel-price">{{item.price || copy.priceUnknown}} <text class="per-night">/ {{copy.night}}</text></view>
          <view class="result-action">{{copy.copyBooking}}</view>
        </view>
      </view>
    </view>
    <view wx:elif="{{hotelSearched && !hotelBusy}}" class="empty">
      <view class="empty-icon">—</view>
      <view class="empty-text">{{copy.emptyHotels}}</view>
    </view>
  </view>

  <!-- ═══════════ 机票 panel ═══════════ -->
  <view wx:if="{{tab === 'flights'}}" class="panel">

    <!-- 单程 / 往返 -->
    <view class="trip-toggle">
      <view class="trip-btn {{flightTripType === 'round' ? 'active' : ''}}" bindtap="setTripType" data-type="round">{{copy.round}}</view>
      <view class="trip-btn {{flightTripType === 'oneway' ? 'active' : ''}}" bindtap="setTripType" data-type="oneway">{{copy.oneway}}</view>
    </view>

    <!-- 出发城市 -->
    <view class="form-section-label">{{copy.origin}}</view>
    <scroll-view scroll-x enable-flex class="chips-row" show-scrollbar="{{false}}">
      <view
        wx:for="{{cities}}"
        wx:key="iata"
        class="chip {{flightOrigin === item.iata ? 'active' : ''}}"
        bindtap="selectOrigin"
        data-iata="{{item.iata}}"
      >{{item.name}} · {{item.iata}}</view>
      <view class="chip {{flightOrigin === '__custom__' ? 'active' : ''}}" bindtap="customOrigin">{{copy.other}}</view>
    </scroll-view>

    <view wx:if="{{customOriginName}}" class="custom-origin-display">
      {{copy.selected}}<text class="teal">{{customOriginName}}</text>
    </view>

    <!-- 日期 + 人数 -->
    <view class="form-row">
      <view class="field">
        <view class="field-label">{{copy.depart}}</view>
        <picker mode="date" value="{{flightDepart}}" start="{{today}}" bindchange="onFlightDepart">
          <view class="picker-display">{{flightDepart}}</view>
        </picker>
      </view>
      <view wx:if="{{flightTripType === 'round'}}" class="field">
        <view class="field-label">{{copy.returnDate}}</view>
        <picker mode="date" value="{{flightReturn}}" start="{{today}}" bindchange="onFlightReturn">
          <view class="picker-display">{{flightReturn}}</view>
        </picker>
      </view>
      <view wx:else class="field">
        <view class="field-label">{{copy.people}}</view>
        <picker mode="selector" range="{{adultsRange}}" value="{{flightAdultsIdx}}" bindchange="onFlightAdults">
          <view class="picker-display">{{flightAdultsIdx + 1}} {{flightAdultsIdx === 0 ? copy.personOne : copy.person}}</view>
        </picker>
      </view>
    </view>
    <view wx:if="{{flightTripType === 'round'}}" class="form-row">
      <view class="field flex-1">
        <view class="field-label">{{copy.people}}</view>
        <picker mode="selector" range="{{adultsRange}}" value="{{flightAdultsIdx}}" bindchange="onFlightAdults">
          <view class="picker-display">{{flightAdultsIdx + 1}} {{flightAdultsIdx === 0 ? copy.personOne : copy.person}}</view>
        </picker>
      </view>
    </view>

    <button class="search-btn" bindtap="searchFlightsHandler" loading="{{flightBusy}}" disabled="{{flightBusy}}">
      {{flightBusy ? copy.searching : copy.searchFlights}}
    </button>

    <!-- 结果 -->
    <view wx:if="{{flightResults.length > 0}}" class="results">
      <view
        wx:for="{{flightResults}}"
        wx:key="flight_no"
        class="flight-card"
        bindtap="openFlightLink"
      >
        <image wx:if="{{item.airline_logo}}" src="{{item.airline_logo}}" class="flight-logo" mode="aspectFit" />
        <view wx:else class="flight-logo-placeholder"><image src="/assets/nav/flight.png" mode="aspectFit" aria-hidden="true" /></view>
        <view class="flight-info">
          <view class="flight-route">
            <text class="time">{{item.depart_time_short}}</text> {{item.depart_id}}
            <text class="arrow"> → </text>
            <text class="time">{{item.arrive_time_short}}</text> {{item.arrive_id}}
          </view>
          <view class="flight-meta">{{item.airline}} · {{item.duration_label}}</view>
          <view class="flight-stops {{item.stops === 0 ? 'direct' : item.stops === 1 ? 'one-stop' : 'multi'}}">{{item.stops_label}}</view>
          <view class="result-action">{{copy.copyBooking}}</view>
        </view>
        <view class="flight-price">{{item.price}}</view>
      </view>
      <view class="flight-book-all" bindtap="openFlightLink">{{copy.copyFlights}}</view>
    </view>
    <view wx:elif="{{flightSearched && !flightBusy}}" class="empty">
      <view class="empty-icon">—</view>
      <view class="empty-text">{{copy.emptyFlights}}</view>
    </view>
  </view>

</view>
