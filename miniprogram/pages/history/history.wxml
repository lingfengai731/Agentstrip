<view class="history-page">
  <view class="header">
    <view class="title">{{copy.historyTitle}}</view>
    <view class="subtitle">{{copy.historySub}}</view>
  </view>
  <view wx:if="{{loading}}" class="state">{{copy.loading}}</view>
  <view wx:if="{{error}}" class="state error">
    <view>{{error}}</view>
    <button class="state-action" bindtap="load">{{copy.retry}}</button>
  </view>
  <view wx:if="{{!loading && !error && conversations.length === 0}}" class="state">
    <view class="empty-icon">≡</view>
    <view>{{copy.emptyHistory}}</view>
    <view class="empty-sub">{{copy.emptyHint}}</view>
  </view>
  <view class="list">
    <view wx:for="{{conversations}}" wx:key="id" class="item">
      <view class="item-main" bindtap="open" data-id="{{item.id}}">
        <view class="item-title">{{item.title}}</view>
        <view class="item-meta">{{item.dest}} · {{item.updated_at}}</view>
      </view>
      <button class="delete" bindtap="remove" data-id="{{item.id}}">{{copy.delete}}</button>
    </view>
  </view>
</view>
