.history-page{min-height:100vh;padding:30rpx 24rpx;background:#faf7f2;box-sizing:border-box;color:#26342f}.header{padding:26rpx 12rpx 30rpx}.eyebrow{font-size:20rpx;letter-spacing:.16em;font-weight:800;color:#9b6117}.title{margin-top:12rpx;font-size:40rpx;font-weight:850}.subtitle{margin-top:10rpx;color:#747b77;font-size:24rpx}.state{padding:70rpx 30rpx;border-radius:28rpx;background:#fff;text-align:center;color:#747b77}.state.error{color:#ae4030}.state button{margin-top:20rpx;background:none;color:#0e7c6b}.state button::after{border:0}.empty-icon{font-size:64rpx}.empty-sub{margin-top:12rpx;font-size:22rpx}.list{display:flex;flex-direction:column;gap:16rpx}.item{display:flex;align-items:center;gap:16rpx;padding:26rpx;border:1rpx solid #e7e0d5;border-radius:24rpx;background:#fff}.item-main{min-width:0;flex:1}.item-title{font-size:27rpx;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.item-meta{margin-top:8rpx;color:#8a908c;font-size:21rpx}.delete{margin:0;padding:10rpx 14rpx;background:#fff5f3;color:#a94b3b;font-size:20rpx}.delete::after{border:0}
