.driver-page { min-height: 100vh; padding: 28rpx 28rpx 210rpx; box-sizing: border-box; }
.driver-hero { padding: 24rpx 6rpx 30rpx; }
.eyebrow { color: #B75E08; font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; }
.hero-title { margin-top: 10rpx; font-size: 42rpx; line-height: 1.25; font-weight: 800; color: #2A2723; }
.hero-copy { margin-top: 12rpx; color: #5A554F; font-size: 25rpx; line-height: 1.7; }
.section { margin-bottom: 22rpx; padding: 28rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(42,39,35,.06); }
.section-title { margin-bottom: 20rpx; font-size: 28rpx; font-weight: 800; }
.driver-grid, .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.driver-card { display: flex; align-items: center; gap: 14rpx; padding: 20rpx; border: 2rpx solid #E1DCD3; border-radius: 18rpx; }
.driver-card.active { border-color: #0E7C6B; background: #E3F5F1; color: #0E6658; }
.driver-card b, .driver-card small { display: block; }
.driver-card small { margin-top: 3rpx; color: #6F6962; font-size: 20rpx; }
.avatar { width: 54rpx; height: 54rpx; border-radius: 50%; background: #0E7C6B; color: #fff; text-align: center; line-height: 54rpx; font-weight: 800; }
.route-badge { margin-bottom: 16rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: #FFF1DC; color: #8B4A0B; font-size: 22rpx; font-weight: 700; }
.field, .textarea { width: 100%; margin-bottom: 16rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 14rpx; background: #F4F1EB; color: #2A2723; font-size: 26rpx; }
.field { height: 84rpx; line-height: 84rpx; }
.picker { color: #5A554F; }
.textarea { height: 190rpx; padding-top: 20rpx; line-height: 1.55; }
.textarea.compact { height: 130rpx; }
.services { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx 12rpx; margin-bottom: 26rpx; }
.services label { font-size: 25rpx; }
.consent { display: flex; align-items: flex-start; gap: 10rpx; color: #5A554F; font-size: 23rpx; line-height: 1.6; }
.error { margin: 0 4rpx 18rpx; padding: 18rpx; border-radius: 14rpx; background: #FDE9E6; color: #A62F2F; font-size: 24rpx; }
.sticky-action { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(250,247,242,.97); border-top: 1rpx solid #E1DCD3; }
.submit { width: 100%; margin: 0; border-radius: 16rpx; background: #0E7C6B; color: #fff; font-size: 29rpx; font-weight: 800; }
.submit::after { border: 0; }
.privacy-note { margin-top: 8rpx; color: #6F6962; font-size: 20rpx; text-align: center; }
.success-card { margin-top: 100rpx; padding: 50rpx 34rpx; border-radius: 28rpx; background: #fff; text-align: center; box-shadow: 0 12rpx 40rpx rgba(42,39,35,.08); }
.success-mark { width: 84rpx; height: 84rpx; margin: 0 auto 22rpx; border-radius: 50%; background: #E3F5F1; color: #0E6658; font-size: 48rpx; line-height: 84rpx; }
.success-title { font-size: 36rpx; font-weight: 800; }
.success-copy { margin: 14rpx 0 30rpx; color: #5A554F; font-size: 25rpx; line-height: 1.7; }
