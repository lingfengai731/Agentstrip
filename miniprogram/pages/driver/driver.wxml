<view class="driver-page">
  <view wx:if="{{sent}}" class="success-card">
    <view class="success-mark">✓</view>
    <view class="success-title">{{copy.successTitle}}</view>
    <view class="success-copy">{{copy.successCopy}}</view>
    <button class="btn" bindtap="back">{{copy.back}}</button>
  </view>

  <block wx:else>
    <view class="driver-hero">
      <view class="hero-title">{{copy.heroTitle}}</view>
      <view class="hero-copy">{{copy.heroCopy}}</view>
    </view>

    <view class="section">
      <view class="section-title">{{copy.chooseDriver}}</view>
      <view class="driver-grid">
        <view class="driver-card {{driverId === 'dicky' ? 'active' : ''}}" bindtap="selectDriver" data-id="dicky"><view class="avatar">D</view><view><text class="driver-name">Dicky</text><text class="driver-role">{{copy.driverRole}}</text></view></view>
        <view class="driver-card {{driverId === 'gede' ? 'active' : ''}}" bindtap="selectDriver" data-id="gede"><view class="avatar">G</view><view><text class="driver-name">Gede Nico</text><text class="driver-role">{{copy.driverRole}}</text></view></view>
      </view>
    </view>

    <view class="section estimate-section">
      <view class="section-kicker">{{copy.estimateKicker}}</view>
      <view class="section-title">{{copy.estimateTitle}}</view>
      <view class="estimate-copy">{{copy.estimateCopy}}</view>
      <view class="two-col estimate-fields">
        <view class="field-group"><view class="field-label">{{copy.fullDayField}}</view><picker mode="selector" range="{{dayOptions}}" value="{{fullDays}}" bindchange="setFullDays"><view class="field picker">{{fullDays}} {{copy.days}}</view></picker></view>
        <view class="field-group"><view class="field-label">{{copy.halfDayField}}</view><picker mode="selector" range="{{dayOptions}}" value="{{halfDays}}" bindchange="setHalfDays"><view class="field picker">{{halfDays}} {{copy.days}}</view></picker></view>
      </view>
      <view class="estimate-total"><view class="estimate-label">{{copy.estimateTotal}}</view><view class="estimate-value">{{estimate.totalLabel}}</view></view>
      <view class="estimate-lines"><view wx:for="{{estimate.breakdown}}" wx:key="*this">{{item}}</view><view wx:for="{{estimate.additions}}" wx:key="*this" class="estimate-addition">{{item}}</view></view>
      <view class="estimate-note">{{copy.estimateNote}}</view>
    </view>

    <view class="section">
      <view class="section-title">{{copy.tripSection}}</view>
      <view wx:if="{{routeId}}" class="route-badge">{{copy.routePrefill}} {{routeId}}</view>
      <view class="two-col">
        <view class="field-group"><view class="field-label">{{copy.firstName}}</view><input class="field" placeholder="{{copy.firstNamePlaceholder}}" value="{{firstName}}" bindinput="onInput" data-field="firstName" /></view>
        <view class="field-group"><view class="field-label">{{copy.lastName}}</view><input class="field" placeholder="{{copy.optional}}" value="{{lastName}}" bindinput="onInput" data-field="lastName" /></view>
      </view>
      <view class="field-group"><view class="field-label">{{copy.email}}</view><input class="field" placeholder="{{copy.emailPlaceholder}}" value="{{email}}" bindinput="onInput" data-field="email" /></view>
      <view class="field-hint">{{copy.emailHint}}</view>
      <view class="two-col">
        <view class="field-group"><view class="field-label">{{copy.startDate}}</view><picker mode="date" value="{{startDate}}" bindchange="setStart"><view class="field picker">{{startDate || copy.chooseDate}}</view></picker></view>
        <view class="field-group"><view class="field-label">{{copy.endDate}}</view><picker mode="date" value="{{endDate}}" bindchange="setEnd"><view class="field picker">{{endDate || copy.chooseDate}}</view></picker></view>
      </view>
      <view class="field-group"><view class="field-label">{{copy.people}}</view><picker mode="selector" range="{{peopleOptions}}" value="{{people - 1}}" bindchange="setPeople"><view class="field picker">{{people}} {{copy.peopleUnit}}</view></picker></view>
      <view class="field-group"><view class="field-label">{{copy.pickup}}</view><input class="field" placeholder="{{copy.pickupPlaceholder}}" value="{{pickup}}" bindinput="onInput" data-field="pickup" /></view>
      <view class="field-group"><view class="field-label">{{copy.budget}}</view><input class="field" placeholder="{{copy.optional}}" value="{{budget}}" bindinput="onInput" data-field="budget" /></view>
      <view class="field-group"><view class="field-label">{{copy.attractions}}</view><textarea class="textarea" placeholder="{{copy.attractionsPlaceholder}}" value="{{attractions}}" bindinput="onInput" data-field="attractions" maxlength="2000" /></view>
      <view class="field-group"><view class="field-label">{{copy.intro}}</view><textarea class="textarea compact" placeholder="{{copy.introPlaceholder}}" value="{{intro}}" bindinput="onInput" data-field="intro" maxlength="800" /></view>
    </view>

    <view class="section">
      <view class="section-title">{{copy.services}}</view>
      <checkbox-group class="services" bindchange="setServices">
        <label wx:for="{{serviceOptions}}" wx:key="value"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#0E7C6B" />{{item.label}}</label>
      </checkbox-group>
      <checkbox-group bindchange="setConsent"><label class="consent"><checkbox value="yes" checked="{{privacyConsent}}" color="#0E7C6B" />{{copy.consent}}</label></checkbox-group>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="sticky-action"><button class="submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy ? copy.submitBusy : copy.submit}}</button><view class="privacy-note">{{copy.privacy}}</view></view>
  </block>

  <view class="history-section">
    <view class="history-title-row"><view class="section-title">{{copy.historyTitle}}</view><button class="refresh-btn" bindtap="loadRequests" loading="{{loadingRequests}}" disabled="{{loadingRequests}}">{{copy.refresh}}</button></view>
    <view wx:if="{{requestsError}}" class="history-error">{{requestsError}}</view>
    <view wx:if="{{loadingRequests && !requests.length}}" class="history-empty">{{copy.loadingReplies}}</view>
    <view wx:elif="{{!requests.length}}" class="history-empty">{{copy.historyEmpty}}</view>
    <view wx:else class="history-list">
      <view class="history-card" wx:for="{{requests}}" wx:key="request_id">
        <view class="history-card-head">
          <view><view class="history-driver">{{item.driver}}</view><view class="history-date">{{item.dateLabel}}</view></view>
          <view class="status-chip status-{{item.status}}">{{item.statusLabel}}</view>
        </view>
        <view class="history-meta" wx:if="{{item.tripLabel}}">{{item.tripLabel}}</view>
        <view class="history-meta" wx:if="{{item.route_id}}">{{copy.routeLabel}} {{item.route_id}}</view>
        <view class="history-reply" wx:if="{{item.reply}}">
          <view class="history-reply-label">{{copy.replyLabel}} · {{item.replyDateLabel}}</view>
          <view class="history-reply-text">{{item.reply.message}}</view>
        </view>
        <view class="history-note" wx:elif="{{item.reply_available}}">{{copy.replyAvailable}}</view>
      </view>
    </view>
  </view>
</view>
