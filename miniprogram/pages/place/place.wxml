<view class="place-page">
  <view wx:if="{{loading}}" class="state-card">{{copy.placeLoading}}</view>
  <view wx:if="{{error}}" class="state-card error"><text>{{error}}</text><button class="retry" bindtap="retry">{{copy.reload}}</button></view>

  <block wx:if="{{place}}">
    <view class="photo-stage">
      <swiper wx:if="{{images.length}}" class="photo-swiper" current="{{current}}" indicator-dots="{{images.length > 1}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#FCBF1E" bindchange="onSlide">
        <swiper-item wx:for="{{images}}" wx:key="key">
          <image class="place-image" src="{{item.fullUrl}}" webp="{{true}}" mode="aspectFill" show-menu-by-longpress="{{true}}" data-index="{{index}}" bindload="markImageLoaded" binderror="markImageFailed" />
          <view wx:if="{{item.imageFailed}}" class="place-image place-image-fallback image-error-overlay"><text>{{copy.imageFailed}}</text><button class="action secondary" data-index="{{index}}" catchtap="retryImage">{{copy.reload}}</button></view>
        </swiper-item>
      </swiper>
      <view wx:else class="photo-empty">{{copy.photoEmpty}}</view>
      <view wx:if="{{images.length}}" class="photo-count">{{current + 1}} / {{images.length}}</view>
    </view>

    <view class="place-card">
      <view class="eyebrow">{{place.region || 'BALI'}}{{routeId ? ' · ' + routeId : ''}}</view>
      <view class="place-title">{{place.title}}</view>
      <view class="place-description">{{place.description}}</view>
      <view class="facts">
        <text wx:if="{{place.type}}">{{place.type}}</text>
        <text wx:if="{{place.routesText}}">{{copy.route}} {{place.routesText}}</text>
      </view>
      <view class="live-note">{{copy.liveNote}}</view>
      <view wx:if="{{place.supplierNote}}" class="supplier-note">
        <view class="supplier-note-title">{{copy.localOperator}}</view>
        <view>{{place.supplierNote}}</view>
      </view>
    </view>

    <view wx:if="{{images.length}}" class="credits-card">
      <view class="credits-title">{{copy.currentPhoto}}</view>
      <view class="credits-name">{{images[current].alt || images[current].title}}</view>
      <view class="credits-scope">{{images[current].scope === 'exact_place' ? copy.exact : copy.reference}}</view>
      <view class="credits-line">{{images[current].rights.credit}}</view>
      <button wx:if="{{images[current].rights.sourceUrl}}" class="link-btn" data-value="{{images[current].rights.sourceUrl}}" bindtap="copyLink">{{copy.source}}</button>
      <button wx:if="{{images[current].rights.licenseUrl}}" class="link-btn" data-value="{{images[current].rights.licenseUrl}}" bindtap="copyLink">{{images[current].rights.credit}}</button>
    </view>

    <view class="actions-card">
      <button wx:if="{{place.officialUrl}}" class="action primary" data-value="{{place.officialUrl}}" bindtap="copyLink">{{copy.official}}</button>
      <button wx:if="{{place.bookingUrl}}" class="action secondary" data-value="{{place.bookingUrl}}" bindtap="copyLink">{{copy.booking}}</button>
      <button class="action secondary" bindtap="backToTrips">{{copy.back}}</button>
    </view>
  </block>
</view>
