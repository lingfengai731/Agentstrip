<view class="food-page">
  <view class="food-hero"><view class="eyebrow">BALI · {{copy.title}}</view><view class="title">{{copy.headline}}</view><view class="intro">{{copy.intro}}</view></view>
  <view class="trip-card"><view class="subtitle">{{copy.trip}}</view><view class="intro">{{hasPlan ? copy.handoff : copy.noPlan}}</view><picker wx:if="{{hasPlan}}" range="{{days}}" range-key="label" value="{{dayIndex}}" bindchange="change" data-key="dayIndex"><view class="control">{{days[dayIndex].label}} <text>⌄</text></view></picker><button bindtap="browse">{{copy.browse}}</button></view>
  <view class="filters">
    <view><view class="label">{{copy.region}}</view><button class="control" bindtap="openFilter" data-key="regionIndex" disabled="{{loading || !!error}}"><text class="control-label">{{regions[regionIndex].label || copy.all}}</text><view class="chevron" aria-hidden="true"></view></button></view>
    <view><view class="label">{{copy.category}}</view><button class="control" bindtap="openFilter" data-key="categoryIndex" disabled="{{loading || !!error}}"><text class="control-label">{{categories[categoryIndex].label || copy.all}}</text><view class="chevron" aria-hidden="true"></view></button></view>
    <view><view class="label">{{copy.cuisine}}</view><button class="control" bindtap="openFilter" data-key="cuisineIndex" disabled="{{loading || !!error}}"><text class="control-label">{{cuisines[cuisineIndex].label || copy.all}}</text><view class="chevron" aria-hidden="true"></view></button></view>
    <view><view class="label">{{copy.scene}}</view><button class="control" bindtap="openFilter" data-key="sceneIndex" disabled="{{loading || !!error}}"><text class="control-label">{{scenes[sceneIndex].label || copy.all}}</text><view class="chevron" aria-hidden="true"></view></button></view>
    <view><view class="label">{{copy.budget}}</view><button class="control" bindtap="openFilter" data-key="budgetIndex" disabled="{{loading || !!error}}"><text class="control-label">{{budgets[budgetIndex].label || copy.all}}</text><view class="chevron" aria-hidden="true"></view></button></view>
    <view><view class="label">{{copy.meal}}</view><button class="control" bindtap="openFilter" data-key="mealIndex" disabled="{{loading || !!error}}"><text class="control-label">{{meals[mealIndex].label || copy.all}}</text><view class="chevron" aria-hidden="true"></view></button></view>
  </view>
  <view wx:if="{{error}}" class="state">{{error}}<button bindtap="retry">{{copy.retry}}</button></view>
  <view wx:if="{{!loading && !error && !items.length}}" class="state">{{copy.empty}}</view>
  <view wx:for="{{items}}" wx:key="id" class="food-card">
    <view class="eyebrow">{{item.area}} · {{item.categoryLabel}}</view><view class="name">{{item.name}}</view><view class="intro">{{item.address || item.area}}</view><view class="intro">{{item.budgetLabel}} · {{item.mealLabel}}</view><view wx:if="{{item.spend}}" class="intro">{{copy.reference}}: {{item.spend}}</view><view class="date">{{item.dateLabel}}</view>
    <view class="links"><button bindtap="source" data-id="{{item.id}}" data-kind="map">{{copy.map}}</button><button bindtap="source" data-id="{{item.id}}" data-kind="source">{{copy.source}}</button></view><button class="add" bindtap="add" data-id="{{item.id}}">{{hasPlan ? copy.add : copy.choose}}</button>
  </view>
  <view wx:if="{{filterOpen}}" class="filter-overlay">
    <view class="filter-backdrop" bindtap="closeFilter"></view>
    <view class="filter-sheet">
      <view class="filter-heading"><view class="subtitle">{{filterTitle}}</view><button class="filter-close" bindtap="closeFilter">{{closeLabel}}</button></view>
      <scroll-view scroll-y class="filter-options">
        <button wx:for="{{filterOptions}}" wx:key="id" class="filter-option {{index === filterSelected ? 'selected' : ''}}" bindtap="selectFilter" data-index="{{index}}"><text>{{item.label}}</text><text wx:if="{{index === filterSelected}}" class="filter-check">✓</text></button>
      </scroll-view>
    </view>
  </view>
</view>
