.food-page{padding:36rpx 28rpx 64rpx;background:#faf7f2;color:#203c37}.food-hero{margin-bottom:32rpx}.eyebrow{font-size:23rpx;font-weight:600;color:#0e7c6b}.title{font-size:46rpx;font-weight:700;line-height:1.3;margin:14rpx 0 20rpx}.intro{font-size:27rpx;line-height:1.6;color:#586b65}.subtitle,.name{font-size:34rpx;font-weight:650;line-height:1.4}.trip-card,.food-card{border:1px solid #e0ded5;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;background:#fff}.trip-card{background:#f1f2e9}.filters{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:30rpx 0}.label{font-size:25rpx;margin-bottom:8rpx;color:#586b65}.control{min-height:44px;box-sizing:border-box;padding:20rpx 18rpx;border:1px solid #e0ded5;border-radius:16rpx;background:#fff;font-size:27rpx;display:flex;justify-content:space-between;gap:10rpx;line-height:1.5}.food-card>view{margin-bottom:12rpx}.date{font-size:23rpx;color:#586b65}.links{display:flex;gap:14rpx}.food-page button{min-height:44px;line-height:1.5;font-size:27rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:18rpx;margin:16rpx 0 0;width:100%;border-radius:16rpx;background:#eef3ee;color:#0e7c6b;white-space:normal}.food-page button::after{border:none}.food-page button.add{background:#0e7c6b;color:#fff}.state{padding:24rpx;color:#586b65}
