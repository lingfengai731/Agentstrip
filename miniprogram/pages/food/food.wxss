.food-page{padding:36rpx 28rpx 64rpx;background:#faf7f2;color:#203c37}.food-hero{margin-bottom:32rpx}.eyebrow{font-size:23rpx;font-weight:600;color:#0e7c6b}.title{font-size:46rpx;font-weight:700;line-height:1.3;margin:14rpx 0 20rpx}.intro{font-size:27rpx;line-height:1.6;color:#586b65}.subtitle,.name{font-size:34rpx;font-weight:650;line-height:1.4}.trip-card,.food-card{border:1px solid #e0ded5;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;background:#fff}.trip-card{background:#f1f2e9}.filters{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:30rpx 0}.label{font-size:25rpx;margin-bottom:8rpx;color:#586b65}.control{min-height:44px;box-sizing:border-box;padding:20rpx 18rpx;border:1px solid #e0ded5;border-radius:16rpx;background:#fff;font-size:27rpx;display:flex;justify-content:space-between;gap:10rpx;line-height:1.5}.food-page picker{display:block;min-height:44px}.food-card>view{margin-bottom:12rpx}.date{font-size:23rpx;color:#586b65}.links{display:flex;gap:14rpx}.food-page button{min-height:44px;line-height:1.5;font-size:27rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:18rpx;margin:16rpx 0 0;width:100%;border-radius:16rpx;background:#eef3ee;color:#0e7c6b;white-space:normal}.food-page button::after{border:none}.food-page button.add{background:#0e7c6b;color:#fff}.state{padding:24rpx;color:#586b65}
.food-page button.control{margin:0;min-height:44px;justify-content:space-between;background:var(--white);color:var(--ink);border:1px solid var(--paper-3);font-weight:400;padding:20rpx 18rpx;text-align:left}.filters>view{min-width:0}.control-label{min-width:0;overflow-wrap:anywhere}.chevron{width:12rpx;height:12rpx;border-right:2rpx solid var(--ink-2);border-bottom:2rpx solid var(--ink-2);transform:rotate(45deg);flex-shrink:0;margin:0 4rpx 6rpx}.filter-overlay{position:fixed;inset:0;z-index:1000}.filter-backdrop{position:absolute;inset:0;background:rgba(20,38,32,.35)}.filter-sheet{position:absolute;bottom:0;left:0;right:0;border-radius:var(--radius-lg) var(--radius-lg) 0 0;background:var(--paper);padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;max-height:80vh}.filter-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}.food-page button.filter-close{width:auto;margin:0;padding:16rpx 24rpx;flex-shrink:0}.filter-options{height:55vh}.food-page button.filter-option{width:100%;margin:0 0 12rpx;text-align:left;justify-content:space-between;gap:16rpx;background:var(--white);color:var(--ink);font-weight:400;border:1px solid var(--paper-3)}.food-page button.filter-option.selected{background:var(--teal-pale);border-color:var(--teal);color:var(--teal-dark);font-weight:600}.filter-check{flex-shrink:0;color:var(--teal)}
