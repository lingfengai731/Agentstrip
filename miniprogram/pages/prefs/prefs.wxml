<!--pages/prefs/prefs.wxml — 旅行偏好编辑-->
<view class="prefs-page">

  <view class="hero">
    <view class="hero-title">{{copy.intro}}</view>
    <view class="hero-desc">{{copy.hint}}</view>
  </view>

  <!-- {{copy.budgetTitle}}（单选） -->
  <view class="section">
    <view class="section-title">{{copy.budgetTitle}}</view>
    <view class="chip-row">
      <view
        wx:for="{{budgetOptions}}"
        wx:key="value"
        class="pref-chip {{budgetLevel === item.value ? 'active' : ''}}"
        bindtap="selectBudget"
        data-value="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- {{copy.styleTitle}}（多选） -->
  <view class="section">
    <view class="section-title">{{copy.styleTitle}} <text class="multi-hint">{{copy.multi}}</text></view>
    <view class="chip-row">
      <view
        wx:for="{{styleOptions}}"
        wx:key="value"
        class="pref-chip {{item.selected ? 'active' : ''}}"
        bindtap="toggleStyle"
        data-value="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- {{copy.partyTitle}}（单选） -->
  <view class="section">
    <view class="section-title">{{copy.partyTitle}}</view>
    <view class="chip-row">
      <view
        wx:for="{{partyOptions}}"
        wx:key="value"
        class="pref-chip {{party === item.value ? 'active' : ''}}"
        bindtap="selectParty"
        data-value="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 特殊偏好（备注） -->
  <view class="section">
    <view class="section-title">{{copy.notesTitle}}</view>
    <textarea
      class="notes-input"
      placeholder="{{copy.notesHint}}"
      placeholder-class="textarea-ph"
      placeholder-style="color:#B0A89D;font-size:26rpx;"
      value="{{notes}}" disabled="{{busy}}"
      bindinput="onNotesChange"
      maxlength="200"
      auto-height
    />
    <view class="char-count">{{notes.length}}/200</view>
  </view>

  <!-- 保存按钮 -->
  <view class="action-bar">
    <button class="btn-ghost" bindtap="clearPrefs" disabled="{{busy}}">{{copy.clear}}</button>
    <button class="btn save-btn" bindtap="savePrefs" loading="{{busy}}" disabled="{{busy}}">
      {{busy ? copy.saving : copy.save}}
    </button>
  </view>

  <view wx:if="{{hasAny}}" class="saved-tip">
    {{copy.savedHint}}
  </view>

</view>
