/* pages/prefs/prefs.wxss */
.prefs-page {
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
  box-sizing: border-box;
}

/* —— Hero —— */
.hero {
  padding: 38rpx 4rpx 30rpx;
}
.hero-title { font-size: 39rpx; font-weight: 750; color: #2A2723; }
.hero-desc { max-width: 610rpx; font-size: 24rpx; line-height: 1.6; color: #6F6962; margin-top: 10rpx; }

/* —— Section —— */
.section {
  background: #fff;
  border: 1rpx solid #E5E2DA;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2A2723;
  margin-bottom: 20rpx;
}
.multi-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #8A857F;
  margin-left: 8rpx;
}

/* —— Chips —— */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pref-chip {
  display: flex;
  min-height: 68rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  background: #F6F4EF;
  border: 1rpx solid #E5E2DA;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5A554F;
}
.pref-chip.active {
  background: #E3F5F1;
  border-color: #0E7C6B;
  color: #0E7C6B;
}

/* —— 备注输入框 —— */
.notes-input {
  width: 100%;
  background: #FBFAF7;
  border: 1rpx solid #E5E2DA;
  border-radius: 14rpx;
  padding: 24rpx;
  font-size: 28rpx;
  min-height: 120rpx;
  box-sizing: border-box;
  line-height: 1.5;
  color: #2A2723;
}
.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #8A857F;
  margin-top: 8rpx;
}

/* —— 底部操作栏 —— */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
.btn-ghost {
  flex: 0 0 200rpx;
  background: transparent;
  color: #C13B3B;
  border: 2rpx solid #E1DCD3;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  min-height: 88rpx;
  padding: 0 20rpx;
  line-height: 1.2;
}
.btn-ghost::after { border: none; }
.save-btn {
  flex: 1;
}

.saved-tip {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: #E3F5F1;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #0E7C6B;
  font-weight: 600;
  text-align: left;
}

@media (max-width: 360px) {
  .action-bar { flex-direction: column-reverse; gap: 14rpx; }
  .btn-ghost { width: 100%; flex-basis: auto; }
}
